#!/usr/bin/env expect
# workload.expect — W14's standard workload v1 (0.18.0 D-154), driven on a pty.
# Run by scripts/quality/workload.sh, which sets HOME, the debug switches and
# the sampler; never run by hand against the listener's own HOME.
#
#   workload.expect session <outdir> <phase_minutes> <binary> <counters_url>
#   workload.expect cold    <outdir> <run_n>         <binary> <counters_url>
#   workload.expect g1-use  <outdir> <minutes>       <binary> <counters_url> <cycle_minutes>
#   workload.expect g1-map  <outdir> <minutes>       <binary> <counters_url> <cycle_minutes>
#   workload.expect g1-idle <outdir> <minutes>       <binary> <counters_url> <cycle_minutes>
#
# 149x38: the plan's M5 size (W2.9). Phase changes go to <outdir>/phases.log
# as "<utc> <phase>"; the process id to <outdir>/pid, for the sampler.
set timeout 5
lassign $argv mode outdir arg binary counters cycle
log_user 0
set lf [open "$outdir/phases.log" a]
proc phase {lf s} { puts $lf "[clock format [clock seconds] -format %Y-%m-%dT%H:%M:%SZ -gmt 1] $s"; flush $lf }
# hold keeps the pty drained for secs, pressing key every every seconds (none
# when every is 0): a key is what M6's key-to-frame timing measures.
proc hold {secs key every} {
  set start [clock seconds]; set last $start
  while {[clock seconds] - $start < $secs} {
    expect -timeout 1 -re ".+" {}
    if {$every > 0 && [clock seconds] - $last >= $every} { send -- $key; set last [clock seconds] }
  }
}
proc counters {url file} { catch {exec curl -fs --max-time 10 $url > $file} }

spawn $binary
set pf [open "$outdir/pid" w]; puts $pf [exp_pid]; close $pf
catch {exec stty rows 38 cols 149 < $spawn_out(slave,name)}
# A WAIT THAT TIMES OUT IS A FAILED RUN, never a phase begun late: the soak
# scripts waited for U+00BA where the app draws U+00B0 (the degree sign) and
# began every run on a silent timeout (found by this driver, W14).
expect -timeout 30 "WATCHPOST" {} timeout { phase $lf "FAILED: no frame"; exit 1 }
expect -timeout 180 -re "\\d+°F" {} timeout { phase $lf "FAILED: no data in 180 s"; exit 1 }
phase $lf "L launched: first data"

if {$mode eq "g1-use"} {
  # 0.19.0 G1 (W10.2), the mode in use: the map opened at the place, the
  # Propagation mode opened and its acknowledgement seen; then each cycle a
  # pan (east, then back west, so the view stays near the place), an hour
  # step ahead and back to now, and a frequency entered, alternating two so
  # each entry asks a reach (D-227: G1 holds a frequency while panning).
  send "g"; hold 20 "" 0
  send "P"
  expect -timeout 30 "Enter" {} timeout { phase $lf "FAILED: no acknowledgement"; exit 1 }
  send "\r"
  expect -timeout 120 "MUF" {} timeout { phase $lf "FAILED: the Propagation mode drew no MUF"; exit 1 }
  hold 60 "" 0
  phase $lf "G measured: the Propagation mode open"
  set end [expr {[clock seconds] + $arg * 60}]
  set freqs {14.2 7.15}; set labels {"14.200 MHz" "7.150 MHz"}; set pans {"\033\[C" "\033\[D"}
  for {set i 0} {[clock seconds] < $end} {incr i} {
    set next [expr {[clock seconds] + $cycle * 60}]
    send -- [lindex $pans [expr {$i % 2}]]; hold 10 "" 0
    send -- "\033\[1;2C"; hold 30 "" 0
    send "n"; hold 10 "" 0
    send "F"; sleep 1; send -- [lindex $freqs [expr {$i % 2}]]; send "\r"
    expect -timeout 60 [lindex $labels [expr {$i % 2}]] {
      phase $lf "U$i pan, hour step, [lindex $labels [expr {$i % 2}]] drawn"
    } timeout {
      phase $lf "U$i WARN: [lindex $labels [expr {$i % 2}]] not seen drawn"
    }
    if {$next > $end} { set next $end }
    hold [expr {$next - [clock seconds]}] "" 0
  }
  counters $counters "$outdir/g1-end.json"
} elseif {$mode eq "g1-map"} {
  # G1's arm with the map open and the Propagation mode never opened: the
  # map at the place in Forecast mode, panned on the use arm's cycle, so the
  # difference from the use arm is the mode's own.
  send "g"; hold 20 "" 0
  # The mode's title, drawn whole on the switch; a chip's words are redrawn
  # only where they change, so "Radar Off" never reaches the pty entire.
  send "R"
  expect -timeout 30 "FORECAST MODE" {} timeout { phase $lf "FAILED: Forecast mode not shown"; exit 1 }
  hold 60 "" 0
  phase $lf "G measured: the map open in Forecast mode"
  set end [expr {[clock seconds] + $arg * 60}]
  set pans {"\033\[C" "\033\[D"}
  for {set i 0} {[clock seconds] < $end} {incr i} {
    set next [expr {[clock seconds] + $cycle * 60}]
    send -- [lindex $pans [expr {$i % 2}]]
    phase $lf "M$i pan"
    if {$next > $end} { set next $end }
    hold [expr {$next - [clock seconds]}] "" 0
  }
  counters $counters "$outdir/g1-end.json"
} elseif {$mode eq "g1-idle"} {
  # G1's other arm: the same build and workload's config, the map never
  # opened, so the Propagation mode never fetches (D-76).
  phase $lf "G measured: the mode never opened"
  hold [expr {$arg * 60}] "" 0
  counters $counters "$outdir/g1-end.json"
} elseif {$mode eq "cold"} {
  # One cold open: an empty cache, the map never opened. M5's clock is g.
  send "g"; phase $lf "C$arg open (cold)"
  hold 45 "" 0
  counters $counters "$outdir/cold-$arg.json"
  phase $lf "C$arg counters read"
} else {
  set secs [expr {$arg * 60}]
  phase $lf "A idle (radio off)";                   hold $secs "" 0
  send " "; phase $lf "B radio on (synth)";          hold $secs "" 0
  send " "; sleep 2
  send "g"; phase $lf "C map open at the place (cold), a pan every 15 s"
  hold $secs "\033\[C" 15
  send "1"; sleep 3; send " "
  phase $lf "D map national (lower 48), loop playing";  hold $secs "" 0
  send " "; for {set i 0} {$i < 3} {incr i} { send "+"; sleep 1 }
  phase $lf "E map zoomed in three steps, a pan every 15 s"; hold $secs "\033\[D" 15
  send "\033"; sleep 1
  phase $lf "F map closed, idle";                     hold $secs "" 0
  for {set i 1} {$i <= 5} {incr i} {
    send "g"; phase $lf "W$i open (warm)"; hold 30 "" 0
    send "\033"; hold 5 "" 0
  }
  counters $counters "$outdir/session-end.json"
}
send "q"
expect -timeout 20 eof
phase $lf "quit ok"
close $lf
