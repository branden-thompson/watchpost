#!/usr/bin/env sh
# pre-push: the tests that read the record (0.19.0 W0.1, FR-10.2, REFLECT
# L5) - seconds, so a batch whose record trails its code stops here, before
# the push, not in the hosted gate. It is no gate: make verify still is.
# Installed by `make hooks`.
set -eu
cd "$(git rev-parse --show-toplevel)"
go test -count=1 -run '^(TestWhereThingsHappenNamesRealSymbols|TestAcceptedCostsNamesRealSymbols|TestFollowUpsCiteTestsThatExist|TestTheRosterCitesTestsThatExist|TestEveryRatifiedP10RowNamesCodeThatExists|TestAMethodRowNamesItsReceiver|TestEveryRequirementsTestIsInAPlanTask|TestEveryRulingNamingCodeCitesItsLine)$' ./cmd/watchpost
go test -count=1 -run '^TestTheAsBuiltMapIsKeptInStep$' ./app
go test -count=1 -run '^TestTheAtlasMatchesAFreshRender$' ./tools/atlas
